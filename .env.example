# ── GSM SV 배포 환경값 ──
# compose.yaml 옆에 `.env` 로 복사해서 채운다.
# 이 파일 하나가 compose 변수 치환(IMAGE_TAG, SERVER_NAME)과 app 런타임(NODE_ENV 등)을 모두 담당.
# NEXT_PUBLIC_* 는 빌드 시 이미지에 인라인되므로 여기 두지 않는다(런타임 주입 불가).

# ── compose 변수 치환용 ──
# 배포할 이미지 태그 (develop / main 등)
IMAGE_TAG=develop
# nginx server_name. 포트/IP 접속이면 _ , 프로덕션은 실제 도메인(flooding.kr)
SERVER_NAME=_

# ── app 런타임 ──
NODE_ENV=production
# 평문 HTTP(dev VM)에서 refresh_token 쿠키 저장 허용. HTTPS 프로덕션에선 제거하거나 true.
COOKIE_SECURE=false
# 서버 전용 시크릿 (이미지에 넣지 않는다)
YOUTUBE_API_KEY=
SENTRY_DSN=
